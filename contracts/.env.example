# Network RPC URL (Sepolia Testnet - Chain ID 11155111)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer Private Key (Keep secret! Never commit .env)
PRIVATE_KEY=0xyour_private_key_here

# Diamond Owner Address
OWNER=0xyour_wallet_address_here

# Minimum lock duration in seconds (optional, defaults to 60)
MIN_LOCK=60

# Etherscan API Key (optional, for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
